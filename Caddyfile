{
  auto_https on
  servers {
    timeouts {
      read_body 30s
      read_header 15s
      write 30s
      idle 2m
    }
  }
}

(api_security) {
  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
  }
}

api.axlmc.org {
  import api_security
  request_body {
    max_size 2MB
  }
  reverse_proxy sponsor-gateway:8080 {
    transport http {
      dial_timeout 5s
      response_header_timeout 30s
      read_timeout 35s
    }
  }
}

sponsor.axlmc.org {
  import api_security
  reverse_proxy sponsor-web:80 {
    transport http {
      dial_timeout 5s
      response_header_timeout 15s
    }
  }
}
